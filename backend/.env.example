OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional: PostgreSQL (simulation works in-memory without it)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/pulseflow

# Optional: Redis
REDIS_URL=redis://localhost:6379

# Also doubles as the API auth token: required as "Authorization: Bearer <SECRET_KEY>"
# on REST requests and as "?token=<SECRET_KEY>" on the WebSocket connection.
SECRET_KEY=pulseflow-demo-key
ENVIRONMENT=development
LOG_LEVEL=INFO
SIMULATION_SPEED=60
CORS_ORIGINS=http://localhost:3000
