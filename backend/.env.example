OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional: PostgreSQL (simulation works in-memory without it)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/pulseflow

# Optional: Redis
REDIS_URL=redis://localhost:6379

# JWT signing key for the /api/v1/auth/login token issuer. No longer doubles
# as a bearer token itself — clients now log in via /api/v1/auth/login to get
# a JWT, and that JWT is what's sent as "Authorization: Bearer <token>" on
# REST requests and as "?token=<token>" on the WebSocket connection.
SECRET_KEY=dev-secret-key-change-in-production
ENVIRONMENT=development
LOG_LEVEL=INFO
SIMULATION_SPEED=60
CORS_ORIGINS=http://localhost:3000

# Login credentials for the two auth roles (plaintext env vars, same pattern
# as SECRET_KEY above — no password hashing in this demo-tier auth).
AUTH_VIEWER_USERNAME=viewer
AUTH_VIEWER_PASSWORD=viewer-dev-password
AUTH_OPERATOR_USERNAME=operator
AUTH_OPERATOR_PASSWORD=operator-dev-password
